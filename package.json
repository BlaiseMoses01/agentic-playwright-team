{
  "name": "agentic-playwright-bdd",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "bddgen": "npx bddgen",
    "test:desktop": "npx bddgen && playwright test --project=desktop",
    "test:mobile-chrome": "npx bddgen && playwright test --project=mobile",
    "test:mobile-safari": "npx bddgen && playwright test --project=ios",
    "test:all": "npx bddgen && playwright test",
    "test:headed": "npx bddgen && playwright test --headed",
    "test:debug": "npx bddgen && playwright test --debug",
    "test:ui": "npx bddgen && playwright test --ui",
    "test:trace": "npx bddgen && playwright test --trace on",
    "report": "playwright show-report test-artifacts/playwright-report",
    "trace:show": "playwright show-trace",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "clean": "./scripts/clean-artifacts.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^25.9.4",
    "agent-browser": "^0.9.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "playwright-bdd": "^9.2.0",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  }
}
